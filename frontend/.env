# ─── Soroban / Stellar configuration ─────────────────────────────────────────
#
# VITE_CONTRACT_ID
#   The deployed SureDeposit contract ID on Stellar Testnet.
#   Replace this with the actual contract ID after deploying the contract.
#   Example: CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4SG76W4
#
VITE_CONTRACT_ID=CBAH6BREXC45UE2DY2TLLZQOVR5VY3S7GYYQA7TQR6GHIL6VEF4IZXXZ

# VITE_SOROBAN_RPC
#   Soroban RPC endpoint. The default below points to the Stellar Testnet.
#   For Mainnet use: https://soroban-mainnet.stellar.org
#
VITE_SOROBAN_RPC=https://soroban-testnet.stellar.org

# VITE_NETWORK_PASSPHRASE
#   Stellar network passphrase.
#   Testnet:  "Test SDF Network ; September 2015"
#   Mainnet:  "Public Global Stellar Network ; September 2015"
#
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
